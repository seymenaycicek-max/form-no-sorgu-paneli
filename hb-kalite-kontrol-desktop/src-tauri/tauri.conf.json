{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HB Kalite Kontrol",
  "version": "1.0.0",
  "identifier": "com.hb.kalitekontrol",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://kkhb.vercel.app; connect-src https://kkhb.vercel.app; frame-src https://kkhb.vercel.app; form-action https://kkhb.vercel.app; object-src 'none'; base-uri 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "HB Kalite Kontrol",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 650,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
